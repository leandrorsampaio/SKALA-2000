      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 2 --unix-socket \"$HOME/Library/Application Support/SKALA-2000/hooks.sock\" -H 'X-SKALA-Client: 1' -H 'Content-Type: application/json' --data-binary @- 'http://localhost/v1/events/claude' >/dev/null 2>&1 || true",
            "async": true,
